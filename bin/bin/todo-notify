#!/opt/homebrew/bin/bash
# Scan todo.txt for due/overdue tasks and fire one macOS notification per task,
# per day (dedup via a cache file keyed by today's date).
set -euo pipefail

TODO_FILE="${TODO_FILE:-$HOME/Documents/Notes/todos/todo.txt}"
today="$(date +%Y-%m-%d)"
cache_dir="$HOME/.cache/todo-notify"
seen_file="$cache_dir/notified-$today.txt"

[[ -f "$TODO_FILE" ]] || exit 0

mkdir -p "$cache_dir"
touch "$seen_file"

# Drop cache files from previous days.
find "$cache_dir" -name 'notified-*.txt' ! -name "notified-$today.txt" -delete 2>/dev/null || true

now_epoch="$(date +%s)"

while IFS= read -r line; do
  [[ "$line" == x\ * ]] && continue        # skip completed tasks
  due="$(grep -oE 'due:[0-9]{4}-[0-9]{2}-[0-9]{2}' <<<"$line" | cut -d: -f2 || true)"
  [[ -n "$due" ]] || continue
  # NOTE: tuxedo's own `t:` key means "threshold offset" (e.g. t:-3d), not a
  # time of day — using it here would collide with that. `at:HH:MM` is a
  # plain custom tag tuxedo doesn't recognize or validate.
  time="$(grep -oE 'at: *[0-9]{2}:[0-9]{2}' <<<"$line" | grep -oE '[0-9]{2}:[0-9]{2}' || true)"

  due_epoch="$(date -j -f '%Y-%m-%d %H:%M' "$due ${time:-00:00}" +%s 2>/dev/null || true)"
  [[ -n "$due_epoch" ]] || continue
  (( due_epoch > now_epoch )) && continue  # not due yet

  key="$(md5 -q -s "$line")"
  grep -qxF "$key" "$seen_file" && continue # already notified today

  text="${line#* }"
  if [[ "$due" < "$today" ]]; then
    subtitle="Overdue since $due${time:+ $time}"
  elif [[ -n "$time" ]]; then
    subtitle="Due today at $time"
  else
    subtitle="Due today"
  fi

  osascript -e "display notification \"$text\" with title \"Todo\" subtitle \"$subtitle\" sound name \"Glass\""
  echo "$key" >> "$seen_file"
done < "$TODO_FILE"
